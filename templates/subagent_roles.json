{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": "1.0.0",
  "routingPolicy": "Gemini-Primary -> Luna-Fallback/Audit -> Spark-Backup",
  "roles": [
    {
      "role": "scout",
      "typeName": "research",
      "model": "gemini-3.7-flash-tiered",
      "thinkingLevel": "medium",
      "workspace": "inherit",
      "description": "Fast cross-repo discovery, definition lookup, and log windowing truncation."
    },
    {
      "role": "builder",
      "typeName": "self",
      "model": "gemini-3.7-flash-tiered",
      "thinkingLevel": "high",
      "workspace": "inherit",
      "description": "Incremental code author and local TDD test creator."
    },
    {
      "role": "adversary_auditor",
      "typeName": "research",
      "model": "gpt-5.6-luna",
      "thinkingLevel": "max",
      "workspace": "inherit",
      "description": "Independent red-team reviewer for concurrency deadlocks, boundary tests, and bias-free Diff reviews."
    },
    {
      "role": "fallback_worker",
      "typeName": "self",
      "model": "gpt-5.6-luna",
      "thinkingLevel": "max",
      "workspace": "inherit",
      "description": "Fallback builder when Gemini quota is exhausted."
    },
    {
      "role": "spark_backup",
      "typeName": "research",
      "model": "gpt-5.3-codex-spark",
      "thinkingLevel": "xhigh",
      "workspace": "inherit",
      "description": "Lightweight fallback scout when Luna is unavailable."
    }
  ]
}
